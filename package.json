{
  "name": "kairo-anime-platform",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "build:staging": "CLOUDFLARE_ENV=staging npm run build",
    "build:production": "CLOUDFLARE_ENV=production npm run build",
    "deploy:staging": "npm run build:staging && CLOUDFLARE_ENV=staging wrangler deploy",
    "deploy:production": "npm run build:production && CLOUDFLARE_ENV=production wrangler deploy",
    "cf:typegen": "wrangler types",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:staging": "wrangler d1 migrations apply DB --remote --env staging",
    "db:migrate:production": "wrangler d1 migrations apply DB --remote --env production",
    "typecheck": "tsc -b --pretty",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.0.4",
    "hono": "^4.9.8",
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.9.5",
    "hls.js": "^1.6.15",
    "swiper": "^14.4.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.13.0",
    "@cloudflare/workers-types": "^5.20261016.1",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "typescript": "^5.9.3",
    "vite": "^7.1.12",
    "vitest": "^5.1.0",
    "wrangler": "^4.68.0"
  }
}
