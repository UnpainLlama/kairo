{
  "name": "kairo-anime-platform",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "build:staging": "CLOUDFLARE_ENV=staging npm run build",
    "build:production": "CLOUDFLARE_ENV=production npm run build",
    "deploy:staging": "npm run build:staging && CLOUDFLARE_ENV=staging wrangler deploy",
    "deploy:production": "npm run build:production && CLOUDFLARE_ENV=production wrangler deploy",
    "cf:typegen": "wrangler types",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:staging": "wrangler d1 migrations apply DB --remote --env staging",
    "db:migrate:production": "wrangler d1 migrations apply DB --remote --env production",
    "typecheck": "tsc -b --pretty",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "hono": "^4.13.18",
    "lucide-react": "^1.73.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.9.5",
    "hls.js": "^1.7.4"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.70.1",
    "@cloudflare/workers-types": "^5.20261016.1",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
    "wrangler": "^4.68.0",
    "@vitejs/plugin-react": "^6.3.0"
  }
}
