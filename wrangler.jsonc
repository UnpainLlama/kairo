{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "kairo-anime-platform",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-04",
  "upload_source_maps": true,
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },

  // Top level = local development only (vite dev, local D1). It is never deployed by CI.
  // Bindings and vars are NOT inherited by environments, so each environment below declares its own.
  "d1_databases": [
    { "binding": "DB", "database_name": "kairo-db-local", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "migrations" }
  ],
  "vars": { "APP_ENV": "development", "METADATA_PROVIDERS": "anilist" },

  "env": {
    // Staging: a separate Worker named kairo-anime-platform-staging, its own D1 database and KV namespace.
    "staging": {
      "d1_databases": [
        { "binding": "DB", "database_name": "kairo-db-staging", "database_id": "30aa5446-f146-4253-b778-0ab88193ebe8", "migrations_dir": "migrations" }
      ],
      "kv_namespaces": [
        { "binding": "METADATA_CACHE", "id": "bddfe8f83eb54167a7418c9c1482cd8f" }
      ],
      "vars": { "APP_ENV": "staging", "METADATA_PROVIDERS": "anilist" }
    },

    // Production: defined but NOT deployable until you approve it (see docs/DEPLOYMENT.md, section 8).
    "production": {
      "d1_databases": [
        { "binding": "DB", "database_name": "kairo-db", "database_id": "REPLACE_WITH_PRODUCTION_D1_DATABASE_ID", "migrations_dir": "migrations" }
      ],
      "kv_namespaces": [
        { "binding": "METADATA_CACHE", "id": "REPLACE_WITH_PRODUCTION_KV_NAMESPACE_ID" }
      ],
      "vars": { "APP_ENV": "production", "METADATA_PROVIDERS": "anilist" }
    }
  }
}
