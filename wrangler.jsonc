{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "kairo-anime-platform",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-04",
  "upload_source_maps": true,
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },

  // Local development
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kairo-db-local",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],

  "vars": {
    "APP_ENV": "development",
    "APP_BASE_URL": "http://localhost:5173",
    "METADATA_PROVIDERS": "anilist",
    "CATALOG_SOURCE": "live",
    "LIVE_PROVIDERS": "anilist,hianime,jikan",
    "EPISODE_PROVIDERS": "jikan",
    "HIANIME_BASE_URL": "https://hianimez.to",
    "HIANIME_PLAYBACK_ALLOWED_HOSTS": ""
  },

  "env": {
    // Staging
    "staging": {
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "kairo-db-staging",
          "database_id": "30aa5446-f146-4253-b778-0ab88193ebe8",
          "migrations_dir": "migrations"
        }
      ],

      "kv_namespaces": [
        {
          "binding": "METADATA_CACHE",
          "id": "bddfe8f83eb54167a7418c9c1482cd8f"
        }
      ],

      "vars": {
        "APP_ENV": "staging",
        "APP_BASE_URL": "https://kairo-anime-platform-staging.unpainllama.workers.dev",
        "METADATA_PROVIDERS": "anilist",
        "CATALOG_SOURCE": "live",
        "LIVE_PROVIDERS": "anilist,hianime,jikan",
        "EPISODE_PROVIDERS": "hianime,jikan",
        "HIANIME_BASE_URL": "https://hianime.at",
        "HIANIME_PLAYBACK_ALLOWED_HOSTS": "zokoanime.video,megaplay.buzz,hls.dramahot.top,hls1.drama1.cfd,mysubsplay.com,emeralddrift.world,hianime.at,hls1drama1.cfd,mysubplay.com,emeralddrift.com"
      }
    },

    // Production - unchanged; do not deploy until approved
    "production": {
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "kairo-db",
          "database_id": "REPLACE_WITH_PRODUCTION_D1_DATABASE_ID",
          "migrations_dir": "migrations"
        }
      ],

      "kv_namespaces": [
        {
          "binding": "METADATA_CACHE",
          "id": "REPLACE_WITH_PRODUCTION_KV_NAMESPACE_ID"
        }
      ],

      "vars": {
        "APP_ENV": "production",
        "APP_BASE_URL": "https://kairo.example.com",
        "METADATA_PROVIDERS": "anilist",
        "CATALOG_SOURCE": "live",
        "LIVE_PROVIDERS": "anilist,jikan"
      }
    }
  }
}
