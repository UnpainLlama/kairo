{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "kairo-anime-platform",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-04",
  "upload_source_maps": true,
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/*.*"]
  },

  // Local development
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kairo-db-local",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],

  "vars": {
    "APP_ENV": "development",
    "APP_BASE_URL": "http://localhost:5173",
    "METADATA_PROVIDERS": "",
    "CATALOG_SOURCE": "live",
    "EPISODE_PROVIDERS": "jikan",
    "HIANIME_BASE_URL": "https://hianimez.to",
    "HIANIME_PLAYBACK_ALLOWED_HOSTS": "",
    "ZOKOANIME_EMBED_ENABLED": "false",
    "MOVIES_TMDB_ENABLED": "false",
    "MOVIES_TMDB_TERMS_APPROVED": "false",
    "MOVIES_INGESTION_ENABLED": "false"
  },

  "env": {
    // Staging
    "staging": {
      "observability": {
        "logs": {
          "enabled": true,
          "invocation_logs": true,
          "head_sampling_rate": 1,
          "persist": true
        },
        "traces": {
          "enabled": false
        },
        "issues": {
          "enabled": false
        }
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "kairo-db-staging",
          "database_id": "30aa5446-f146-4253-b778-0ab88193ebe8",
          "migrations_dir": "migrations"
        }
      ],

      "kv_namespaces": [
        {
          "binding": "METADATA_CACHE",
          "id": "bddfe8f83eb54167a7418c9c1482cd8f"
        }
      ],

      "triggers": {
        "crons": ["*/30 * * * *"]
      },

      "vars": {
        "APP_ENV": "staging",
        "APP_BASE_URL": "https://kairo-anime-platform-staging.unpainllama.workers.dev",
        "ACCESS_ENFORCED": "true",
        "ACCESS_TEAM_DOMAIN": "kairo-unpainllama.cloudflareaccess.com",
        "ACCESS_AUD": "726cd3810f4aecf0401da086547e8e2db10b9445a074ee52d728ea1c82f729c6",
        "CATALOG_SOURCE": "live",
        "EPISODE_PROVIDERS": "hianime,jikan",
        "GOOGLE_CLIENT_ID": "805356560035-p3ooq75mvr5cn02s0u98dv7k3vspt49k.apps.googleusercontent.com",
        "HIANIME_BASE_URL": "https://hianime.at",
        "HIANIME_PLAYBACK_ALLOWED_HOSTS": "zokoanime.video,megaplay.buzz,hls.dramahot.top,hls1.drama1.cfd,mysubsplay.com,emeralddrift.world,hianime.at",
        "ZOKOANIME_EMBED_ENABLED": "false",
        "METADATA_PROVIDERS": "",
        "MOVIES_TMDB_ENABLED": "true",
        "MOVIES_TMDB_TERMS_APPROVED": "true",
        "MOVIES_INGESTION_ENABLED": "false"
      }
    },

    // Production - fail-closed template; do not deploy until approved
    "production": {
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "kairo-db",
          "database_id": "REPLACE_WITH_PRODUCTION_D1_DATABASE_ID",
          "migrations_dir": "migrations"
        }
      ],

      "kv_namespaces": [
        {
          "binding": "METADATA_CACHE",
          "id": "REPLACE_WITH_PRODUCTION_KV_NAMESPACE_ID"
        }
      ],

      "vars": {
        "APP_ENV": "production",
        "APP_BASE_URL": "REPLACE_WITH_PRODUCTION_APP_BASE_URL",
        "GOOGLE_CLIENT_ID": "REPLACE_WITH_PRODUCTION_GOOGLE_CLIENT_ID",
        "ACCESS_ENFORCED": "true",
        "ACCESS_TEAM_DOMAIN": "REPLACE_WITH_PRODUCTION_ACCESS_TEAM_DOMAIN",
        "ACCESS_AUD": "REPLACE_WITH_PRODUCTION_ACCESS_AUD",
        "ZOKOANIME_EMBED_ENABLED": "false",
        "METADATA_PROVIDERS": "",
        "CATALOG_SOURCE": "live",
        "MOVIES_TMDB_ENABLED": "false",
        "MOVIES_TMDB_TERMS_APPROVED": "false",
        "MOVIES_INGESTION_ENABLED": "false"
      }
    }
  }
}