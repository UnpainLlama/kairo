# Names only. Put actual values in .dev.vars locally or Cloudflare Worker secrets in production.
# AUTH_ISSUER=
# AUTH_AUDIENCE=
# IDENTITY_PROVIDER_CLIENT_SECRET=
# APPROVED_METADATA_PROVIDER_TOKEN=
# APPROVED_PLAYBACK_PROVIDER_TOKEN=

# Movies provider credentials are Worker secrets, never Vite/client variables.
# TMDB_ACCESS_TOKEN=
# Set these Wrangler vars to true only after confirming the provider licence,
# permitted caching/retention, and attribution requirements:
# MOVIES_TMDB_ENABLED=false
# MOVIES_TMDB_TERMS_APPROVED=false
# MOVIES_INGESTION_ENABLED=false
