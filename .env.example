# Names only. Put actual values in .dev.vars locally or Cloudflare Worker secrets in production.
# AUTH_ISSUER=
# AUTH_AUDIENCE=
# IDENTITY_PROVIDER_CLIENT_SECRET=
# APPROVED_METADATA_PROVIDER_TOKEN=
# APPROVED_PLAYBACK_PROVIDER_TOKEN=

# TMDB powers Movies discovery/catalogue metadata and optional Anime artwork enrichment.
# Store this as a Worker secret, never as a Vite/client variable.
# TMDB_ACCESS_TOKEN=
# CineSrc is the only Movies playback provider; its documented iframe embed needs no Kairo secret.
# Set these Wrangler vars to true only after confirming the provider licence,
# permitted caching/retention, and attribution requirements:
# MOVIES_TMDB_ENABLED=false
# MOVIES_TMDB_TERMS_APPROVED=false
# MOVIES_INGESTION_ENABLED=false

# MyAnimeList API v2 Client ID. Store as a Cloudflare Worker secret, never in browser code.
# Register at https://myanimelist.net/apiconfig and set MAL_CLIENT_ID as a Worker secret.
